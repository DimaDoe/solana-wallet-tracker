# Solana Configuration
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_NETWORK=mainnet-beta

# 1RW Token Configuration
NEXT_PUBLIC_1RW_TOKEN_MINT=YOUR_1RW_TOKEN_MINT_ADDRESS

# Treasury Wallet (receives burned tokens)
NEXT_PUBLIC_TREASURY_WALLET=YOUR_TREASURY_WALLET_ADDRESS

# NFT Collection
NEXT_PUBLIC_NFT_COLLECTION_ADDRESS=YOUR_NFT_COLLECTION_ADDRESS

# Verification Settings
NEXT_PUBLIC_MIN_HOLD_AMOUNT=100
NEXT_PUBLIC_BURN_SINGLE=10
NEXT_PUBLIC_BURN_LIFETIME=50
