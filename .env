# Solana Wallet Tracker - Environment Variables

# Database Configuration
DATABASE_PATH=./data/wallet_tracker.db

# Solana RPC Endpoints (Free Tier)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=cd72b2ac-ef82-4441-a781-c3af2d0f329a
QUICKNODE_RPC_URL=https://multi-nameless-choice.solana-mainnet.quiknode.pro/ab081b54c1d12e3b181967a52edc23fe4725ff74/
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=8138909173:AAFxfq1my2Z5oEc7iF4LKxjJvO_yhYoCbV0
TELEGRAM_CHAT_ID=-1002797162893

# Application Settings
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Rate Limiting
HELIUS_RATE_LIMIT=100000
QUICKNODE_RATE_LIMIT=10000000
POLLING_INTERVAL=300000

# Wallet Discovery Settings
MIN_WALLET_BALANCE=0.1
MIN_TRANSACTION_COUNT=10
DISCOVERY_INTERVAL=600000

# Alert Settings
ALERT_COOLDOWN=300000
MAX_ALERTS_PER_HOUR=50
MIN_TOKEN_MARKET_CAP=1000

# Monitoring Settings
WALLET_MONITOR_INTERVAL=300000
TRANSACTION_HISTORY_DAYS=7
MAX_WALLETS_TO_MONITOR=100